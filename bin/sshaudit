#!/usr/bin/env python3
"""sshaudit launcher -- keeps the package importable without installation."""

import os
import sys

_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if _ROOT not in sys.path:
    sys.path.insert(0, _ROOT)

from sshaudit.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
