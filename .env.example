# sshaudit secrets -- copy to .env and fill in what you need.
#
# .env is git-ignored. Nothing in here is ever committed or written to results/.
# Every value is optional: a notification channel stays disabled if its
# variables are missing.

# --- SSH passwords referenced by inventory 'password_env' -------------------
# STAGING1_SSH_PASSWORD=change-me

# --- Slack / Discord notifications ----------------------------------------
# SSHAUDIT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# SSHAUDIT_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXX/YYY

# --- Email notifications (SMTP) -------------------------------------------
# SSHAUDIT_SMTP_HOST=smtp.example.com
# SSHAUDIT_SMTP_PORT=587
# SSHAUDIT_SMTP_USER=alerts@example.com
# SSHAUDIT_SMTP_PASSWORD=change-me
# SSHAUDIT_SMTP_STARTTLS=true
# SSHAUDIT_EMAIL_FROM=alerts@example.com
# SSHAUDIT_EMAIL_TO=secops@example.com, oncall@example.com

# --- Behaviour overrides (optional) --------------------------------------
# SSHAUDIT_RESULTS_DIR=results
# SSHAUDIT_MAX_PARALLEL=4
# SSHAUDIT_SSH_CONNECT_TIMEOUT=10
# SSHAUDIT_SSH_COMMAND_TIMEOUT=120
